{
  "name": "pennykin",
  "version": "1.11.8",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:animation": "tsc -p tsconfig.tests.json && node --test .test-build/tests/petAnimationMachine.test.js",
    "test:analytics": "npm run test:finance",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/tests/*.test.js tests/*.test.cjs",
    "test:finance": "tsc -p tsconfig.tests.json && node --test .test-build/tests/analytics.test.js tests/financial*.test.cjs tests/calendarDates.test.cjs"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.4",
    "expo-clipboard": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "~19.2.2",
    "lottie-web": "^5.13.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  }
}
